# Local Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://nfc:nfc@localhost:5432/nfc

# Shopify (Step 2) — leave blank until then
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=http://localhost:3000

# Anthropic (Step 5)
ANTHROPIC_API_KEY=

# CDN base URL for the tap page (Step 3)
TAP_PAGE_CDN_URL=http://localhost:3001

# Random secret for signing session cookies — generate with: openssl rand -hex 32
COOKIE_SECRET=dev-secret-change-in-prod

# Twilio (admin app only — for SMS/WhatsApp notifications)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=        # SMS-capable number, e.g. +14165550100
TWILIO_WHATSAPP_FROM=      # WhatsApp sender, e.g. whatsapp:+14165550100 (leave blank if not configured)

# Staff sign-in handoff between the admin and the tap page (PRD v4 §7 Step 13c).
# Defaults: localhost:3000 / localhost:3001 under `next dev`, the production
# domains otherwise. Set these only if you run the apps somewhere else.
ADMIN_BASE_URL=
TAP_PAGE_URL=
